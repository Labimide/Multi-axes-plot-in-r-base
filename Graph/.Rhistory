plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = c(0, 0.8), pch = 22, cex = 2, lwd = 2, lty = 5)
# #Plot sixth y axis
# par(new = T)
#
# dat <- dat1 %>% filter(Enzyme == "aceE (pyruvate dehydrogenase)") %>% select(Specific_growth_rate, Intensity.ratio)
#
# plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "o", col= "black", main = "", ylim = c(0, 1.0), xlim = c(0, 0.8), pch = 15, cex = 1.2, lwd = 2, lty = 6)
#inserting x-axis
axis(1, at = seq(0, 0.8, by = 0.1), cex.axis = 1.2, lwd =2)
mtext(1, text = "Specific growth rate (μ)", line = 2, cex = 1.2)
#Legend
legend("right", inset = c(-0.45, 0), legend = c("ICL", "AcCoA-S", "Acetate kinase", "Phosphotransacetylase", "PEP carboxykinase"), lty = c(rep(1,3), 4,5), pch = c(15, 24, 21, 16, 22), cex = 1.1, pt.cex = c(2, 2, 2, 2, 2), lwd = 2, xpd = T, pt.bg = "white")
dat1 <- read.csv("Intensity readings 2.csv")
dat <- dat1 %>% filter(Enzyme == "aceA (isocitrate lyase)") %>% select(Specific_growth_rate, Intensity.ratio)
par(mar = c(4, 4, 4, 10))
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = c(0, 0.8), pch = 15, cex = 2, lwd = 2, lty = 1)
axis(2, col = "black", lwd = 2, las = 1, cex.axis = 1.2)
mtext(2, text = "Intensity ratio", line = 2.6, cex = 1.2)
#Plot second y axis
par(new = T)
dat <- dat1 %>% filter(Enzyme == "acs (acetyl-CoA synthetase)") %>% select(Specific_growth_rate, Intensity.ratio)
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = c(0, 0.8), pch = 2, cex = 2, lwd = 2, lty = 1)
#axis(2, col = "black", lwd = 2, line = 4.3, at = seq(0, 160, by = 40), las = 1, cex.axis = 1.2)
#mtext(2, text = "ICL activity (units ml-1)", line = 7.0, cex = 1.2)
#Plot third y axis
par(new = T)
dat <- dat1 %>% filter(Enzyme == "ackA (acetate kinase)" & Specific_growth_rate > 0.1) %>% select(Specific_growth_rate, Intensity.ratio)
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = c(0, 0.8), pch = 1, cex = 2, lwd = 2, lty = 1)
#Plot fourth y axis
par(new = T)
dat <- dat1 %>% filter(Enzyme == "pta (phosphotransacetylase)") %>% select(Specific_growth_rate, Intensity.ratio)
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = c(0, 0.8), pch = 16, cex = 2, lwd = 2, lty = 4)
#Plot fifth y axis
