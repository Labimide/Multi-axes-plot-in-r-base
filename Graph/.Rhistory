#mtext(2, text = "ICL activity (units ml-1)", line = 7.0, cex = 1.2)
#Plot third y axis
par(new = T)
dat <- dat1 %>% filter(Enzyme == "ackA (acetate kinase)" & Specific_growth_rate > 0.1) %>% select(Specific_growth_rate, Intensity.ratio)
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = rev(c(0, 0.8)), pch = 1, cex = 2, lwd = 2, lty = 1)
#Plot fourth y axis
par(new = T)
dat <- dat1 %>% filter(Enzyme == "pta (phosphotransacetylase)") %>% select(Specific_growth_rate, Intensity.ratio)
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = rev(c(0, 0.8)), pch = 16, cex = 2, lwd = 2, lty = 4)
#Plot fifth y axis
par(new = T)
dat <- dat1 %>% filter(Enzyme == "pckA (pyruvate carboxykinase)") %>% select(Specific_growth_rate, Intensity.ratio)
plot(dat$Specific_growth_rate, dat$Intensity.ratio, axes = F, ylab = "", xlab = "", type = "b", col= "black", main = "", ylim = c(0, 1.0), xlim = rev(c(0, 0.8)), pch = 22, cex = 2, lwd = 2, lty = 5)
